{
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": ["**", "!!**/dist"]
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		}
	]
}
